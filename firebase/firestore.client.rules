rules_version = '2';

// Client-side rules that match exactly what the app writes today
// (FirebaseAuthRepository, FirebasePostRepository, FirebaseUserRepository,
// FirebaseCommentRepository, FirebaseMessageRepository,
// FirebaseStoryRepository, FirebaseNotificationRepository).
//
// Use these while you are testing without Cloud Functions:
//   firebase deploy --only firestore:rules
// after pointing firebase.json at this file. The stricter production rules in
// firestore.rules assume Cloud Functions own the counters.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Profiles: anyone signed in can read, only the owner can write.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId;
      allow delete: if signedIn() && uid() == userId;

      match /deviceTokens/{token} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    // Username uniqueness index.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // Posts. Anyone signed in may read and may toggle their own like/save;
    // only the author may change the content or delete the post.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    // Comments.
    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    // Follow graph: {followerId}_{followeeId}
    match /follows/{edgeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerId == uid();
      allow delete: if signedIn() && resource.data.followerId == uid();
    }

    // Stories expire after 24 hours; the app filters, the rules protect writes.
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == uid();
    }

    // Conversations and messages: members only.
    match /conversations/{conversationId} {
      allow read, update: if signedIn() && uid() in resource.data.memberIds;
      allow create: if signedIn() && uid() in request.resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          uid() in get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.memberIds;
        allow create: if signedIn() && request.resource.data.senderId == uid();
        allow update: if signedIn();
        allow delete: if signedIn() && resource.data.senderId == uid();
      }
    }

    // Activity feed: you can only read your own notifications.
    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.recipientId == uid();
      allow create: if signedIn() && request.resource.data.actorId == uid();
    }

    // Reports are write-only from the client.
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read: if signedIn() && resource.data.reporterId == uid();
    }
  }
}
