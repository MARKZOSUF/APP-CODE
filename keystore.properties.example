# Copy this file to  keystore.properties  in the PROJECT ROOT (next to
# settings.gradle.kts), then fill in your real values.
#
# These four key names are read verbatim by app/build.gradle.kts:
#     storeFile = file(keystoreProperties.getProperty("storeFile"))
#     storePassword = keystoreProperties.getProperty("storePassword")
#     keyAlias = keystoreProperties.getProperty("keyAlias")
#     keyPassword = keystoreProperties.getProperty("keyPassword")
#
# Do NOT rename them. If this file is absent, no "release" signing config is
# created and the release APK is built UNSIGNED (it will not install).
#
# NEVER commit the real keystore.properties or your .jks file.

# Use forward slashes even on Windows.
storeFile=C:/dev/insangram-release.jks
storePassword=CHANGE_ME
keyAlias=insangram
keyPassword=CHANGE_ME
