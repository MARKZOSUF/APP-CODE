<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme. Colours for Compose come from the Compose color scheme; the
         XML theme only needs to be edge-to-edge friendly and transparent. -->
    <style name="Theme.Insangram" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/insangram_background_light</item>
    </style>

    <!-- Android 12+ splash screen, themed with the supplied logo mark. -->
    <style name="Theme.Insangram.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/insangram_near_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/insangram_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.Insangram</item>
    </style>
</resources>
