<?xml version="1.0" encoding="utf-8"?>
<!--
  Original Insangram mark: a rounded aperture square with an offset ring and a
  spark dot. Deliberately NOT a copy of any existing social-network logo, so it
  is safe for Play Store distribution.

  The artwork is kept inside the adaptive-icon safe zone (the middle 72x72 of
  the 108x108 canvas) so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer rounded square outline -->
    <path
        android:pathData="M42,34h24a8,8 0 0 1 8,8v24a8,8 0 0 1 -8,8h-24a8,8 0 0 1 -8,-8v-24a8,8 0 0 1 8,-8z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.2"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Aperture ring -->
    <path
        android:pathData="M54,44a10,10 0 1 1 -0.1,0z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.2"
        android:fillColor="#00000000" />

    <!-- Spark dot -->
    <path
        android:pathData="M67.5,41.5a3.2,3.2 0 1 1 -0.1,0z"
        android:fillColor="#FFFFFFFF" />
</vector>
